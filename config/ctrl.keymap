#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <locale/keys_de.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad Layer";

            bindings = <
                &kp K_UNDO              &kp K_VOLUME_UP     &kp K_REDO
                &kp K_PREVIOUS          &kp K_PLAY_PAUSE    &kp K_NEXT
                &kp C_AL_CALCULATOR     &kp K_VOLUME_DOWN   &kp PRINTSCREEN
                &kp C_AL_EMAIL          &kp K_WWW           &sys_reset
            >;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_reset {
            timeout-ms = <250>;
            key-positions = <1 4 7>;
            bindings = <&bootloader>;
        };
    };
};
